<!--
  Implementations of the interfaces declared in ReviewMyDoc.Core: object store
  (Azure Blob Storage and a local directory), AI providers and mail.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      Azure Blob Storage and the sign-in that goes with it. Azure.Identity is
      what lets the application reach the container with its managed identity,
      so no key and no connection string has to exist in Azure at all.
    -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <!--
      Data Protection and the one line that keeps its key ring in a blob. It is
      referenced here and not in the web project, so that Program.cs registers
      the key ring without naming an Azure type, the same way it registers the
      object store. The standalone DataProtection package, not the shared
      framework: this assembly is a class library and stays one.
    -->
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.4" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.12" />
    <!--
      Configuration and the service container, so that this assembly can say
      itself which store belongs in the container. Only the abstractions: the
      host brings the implementations.
    -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReviewMyDoc.Core\ReviewMyDoc.Core.csproj" />
  </ItemGroup>

</Project>
