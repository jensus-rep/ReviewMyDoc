@*
    Frame of every page of the application: skip link, head, navigation, content
    and footer. A page brings its content and never its own frame, so what is
    decided here holds for every page that follows.

    The stylesheets are loaded in the order they build on each other: the tokens
    first, because every building block and site.css reads their values, then
    the theme, which writes the colour roles of the tokens over with the house
    colours of this application and has to stand after them to win at equal
    specificity, then the building blocks the partials under Ui/ render, and
    site.css last, so the application can set the values of a building block
    without a specificity fight. The files are delivered from the repository folder components/ under
    /components/ and exist exactly once; nothing of them lies in wwwroot.
*@
@using ReviewMyDoc.Web.Pages.Shared.Ui
@using ReviewMyDoc.Web.Security
@{
    var currentPage = ViewContext.RouteData.Values["page"] as string;
    var signOut = new ButtonModel("Abmelden") { Variant = ButtonVariant.Secondary };
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ReviewMyDoc</title>
    <link rel="stylesheet" href="~/components/tokens/tokens.css" />
    <link rel="stylesheet" href="~/components/theme/theme.css" />
    <link rel="stylesheet" href="~/components/button/button.css" />
    <link rel="stylesheet" href="~/components/field/field.css" />
    <link rel="stylesheet" href="~/components/rows/rows.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app">
    <a class="app__skip" href="#inhalt">Zum Inhalt springen</a>
    <header class="app__header">
        <div class="app__bar">
            <a class="app__brand" href="/">ReviewMyDoc</a>
            <nav class="app__nav" aria-label="Hauptnavigation">
                <a class="app__nav-link" href="/" aria-current="@(currentPage == "/Index" ? "page" : null)">Übersicht</a>
            </nav>
            @* The way out stands in the frame and not on a page, because it
               belongs to every page. It is a form and not a link: a sign-out
               changes something, so it is a post and carries the antiforgery
               token the form tag helper writes. Only somebody who is signed in
               sees it; for everybody else there is nothing to end. *@
            @if (User.IsInRole(OwnerAuthentication.Role))
            {
                <form class="app__session" method="post" asp-page="/Abmelden">
                    <partial name="Ui/_Button" model="signOut" />
                </form>
            }
        </div>
    </header>
    <main class="app__main" id="inhalt">
        @RenderBody()
    </main>
    <footer class="app__footer">
        <p class="app__footer-note">ReviewMyDoc</p>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
