@* A recipient has a deliberately separate frame with no owner navigation. *@
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] · ReviewMyDoc</title>
<link rel="icon" type="image/png" href="~/images/reviewmydoc-logo.png" asp-append-version="true" />
<link rel="stylesheet" href="~/components/tokens/tokens.css" /><link rel="stylesheet" href="~/components/theme/theme.css" />
<link rel="stylesheet" href="~/components/button/button.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head><body class="app"><a class="app__skip" href="#inhalt">Zum Inhalt springen</a>
<header class="app__header"><div class="app__bar"><span class="app__brand"><img class="app__logo" src="~/images/reviewmydoc-logo.png" asp-append-version="true" alt="" width="40" height="40" />ReviewMyDoc</span><span>Gemeinsam wird es besser.</span></div></header>
<main class="app__main" id="inhalt">@RenderBody()</main>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
