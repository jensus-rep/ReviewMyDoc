@page "/dokumente/{documentId}/gliederung"
@*
    The outline of one document: its sections, with a form to append one, and
    for each section a form to rename it, a pair of buttons to move it and a
    link that asks before it is deleted. No section is ever removed straight
    from this list - the deleting form only appears after the visitor followed
    that link and saw what is about to happen, because a browser confirm()
    cannot run under the Content Security Policy of this application.

    Every mutating form carries the ETag the page was rendered with as a
    hidden field, so GliederungModel can tell a change made here from one made
    by another tab in between and never overwrite it silently. The loop
    variable below is named entry and not "section" - the obvious word - since
    @@section is a reserved Razor directive and the parser refuses it even as
    a plain identifier.
*@
@using ReviewMyDoc.Web.Pages.Shared.Ui
@model GliederungModel
@{
    ViewData["Title"] = Model.Title;

    var newHeadingField = new FieldModel(nameof(Model.NewHeading), "Neue Überschrift")
    {
        Value = Model.NewHeading,
        Error = Model.NewHeadingError,
        Required = true,
    };
    var addButton = new ButtonModel("Abschnitt hinzufügen");
}

<div class="document-view">
<a class="document-view__back" href="/dokumente">← Alle Dokumente</a>
<header class="document-view__header">
    <div>
        <p class="document-view__eyebrow">Dein Dokument</p>
        <h1>@Model.Title</h1>
        <p class="document-view__meta"><span class="document-view__status">@Model.StateLabel</span><span>@Model.Sections.Count @(Model.Sections.Count == 1 ? "Abschnitt" : "Abschnitte")</span></p>
    </div>
    <a class="button button--secondary" href="#neuer-abschnitt">+ Abschnitt hinzufügen</a>
</header>

@if (Model.Message is not null)
{
    @* role="alert" so a screen reader reads the sentence as soon as the page
       comes back, exactly as Anmeldung.cshtml does for its own message. *@
    <p class="gliederung__meldung" role="alert">@Model.Message</p>
}

<div class="document-view__layout">
<aside class="document-view__sidebar">
    <nav aria-label="Inhaltsverzeichnis">
        <h2>In diesem Dokument</h2>
        @if (Model.Sections.Count == 0)
        {
            <p>Deine Gliederung entsteht hier, Abschnitt für Abschnitt.</p>
        }
        <ol>
            @foreach (var entry in Model.Sections)
            {
                <li><a href="#abschnitt-@entry.Id.Value"><span>@entry.Order.ToString("D2")</span>@entry.Heading</a></li>
            }
        </ol>
    </nav>
</aside>
<div class="document-view__paper">
<div class="document-view__paper-heading"><span>Gliederung</span><span>Deine Gedanken. Klar strukturiert.</span></div>
    @if (Model.Sections.Count == 0)
    {
        <div class="document-view__empty">
            <span class="document-view__empty-mark" aria-hidden="true">¶</span>
            <h2>Platz für deine Gedanken</h2>
            <p>Dieses Dokument hat noch keine Abschnitte.</p>
            <p>Beginne mit einer Überschrift und gib deinem Dokument eine Struktur.</p>
            <a href="#neuer-abschnitt">Ersten Abschnitt anlegen →</a>
        </div>
    }
    else
    {
        <ol class="gliederung__abschnitte">
            @for (var index = 0; index < Model.Sections.Count; index++)
            {
                var entry = Model.Sections[index];
                var confirmingDelete = Model.PendingDeleteSectionId == entry.Id.Value;
                var renaming = Model.RenameSectionId == entry.Id.Value;
                var headingField = new FieldModel(nameof(Model.RenameHeading), $"Überschrift (Abschnitt {entry.Order})")
                {
                    Id = $"ueberschrift-{entry.Id.Value}",
                    Value = renaming && Model.RenameHeading is not null ? Model.RenameHeading : entry.Heading,
                    Error = renaming ? Model.RenameError : null,
                    Required = true,
                };
                @* Every one of these buttons appears once per section, so the
                   caption alone repeats itself. The caption stays short for the
                   eye; AriaLabel says which section it belongs to for the ear. *@
                var saveButton = new ButtonModel("Speichern")
                {
                    Variant = ButtonVariant.Secondary,
                    AriaLabel = $"Überschrift von „{entry.Heading}“ speichern",
                };
                var upButton = new ButtonModel("Nach oben")
                {
                    Variant = ButtonVariant.Secondary,
                    Disabled = index == 0,
                    AriaLabel = $"„{entry.Heading}“ nach oben verschieben",
                };
                var downButton = new ButtonModel("Nach unten")
                {
                    Variant = ButtonVariant.Secondary,
                    Disabled = index == Model.Sections.Count - 1,
                    AriaLabel = $"„{entry.Heading}“ nach unten verschieben",
                };
                var deleteLink = new ButtonModel("Löschen")
                {
                    Variant = ButtonVariant.Secondary,
                    Href = $"/dokumente/{Model.DocumentId}/gliederung?confirmDelete={entry.Id.Value}",
                    AriaLabel = $"„{entry.Heading}“ löschen",
                };
                var cancelLink = new ButtonModel("Abbrechen")
                {
                    Variant = ButtonVariant.Secondary,
                    Href = $"/dokumente/{Model.DocumentId}/gliederung",
                    AriaLabel = $"Löschen von „{entry.Heading}“ abbrechen",
                };
                var confirmButton = new ButtonModel("Endgültig löschen")
                {
                    AriaLabel = $"„{entry.Heading}“ endgültig löschen",
                };

                <li class="gliederung__abschnitt" id="abschnitt-@entry.Id.Value">
                    <div class="document-view__section-heading">
                        <span class="gliederung__nummer">@entry.Order.ToString("D2")</span>
                        <h2>@entry.Heading</h2>
                    </div>

                    @if (confirmingDelete)
                    {
                        <div class="gliederung__bestaetigung">
                            <p role="alert">Den Abschnitt „@entry.Heading“ wirklich löschen? Der Text des Abschnitts geht dabei verloren.</p>
                            <div class="gliederung__bestaetigung-formular">
                                <form method="post" asp-page-handler="ConfirmDelete">
                                    <input type="hidden" name="SectionId" value="@entry.Id.Value" />
                                    <input type="hidden" name="ETagValue" value="@Model.ETag" />
                                    <partial name="Ui/_Button" model="confirmButton" />
                                </form>
                                <partial name="Ui/_Button" model="cancelLink" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <details class="document-view__edit" open="@(renaming ? true : (bool?)null)">
                        <summary>Abschnitt bearbeiten<span class="document-view__sr-only">: @entry.Heading</span></summary>
                        <div class="document-view__edit-content">
                        <form method="post" asp-page-handler="RenameSection" class="gliederung__umbenennen">
                            <input type="hidden" name="RenameSectionId" value="@entry.Id.Value" />
                            <input type="hidden" name="ETagValue" value="@Model.ETag" />
                            <partial name="Ui/_Field" model="headingField" />
                            <partial name="Ui/_Button" model="saveButton" />
                        </form>

                        <div class="gliederung__aktionen">
                            <form method="post" asp-page-handler="MoveUp">
                                <input type="hidden" name="SectionId" value="@entry.Id.Value" />
                                <input type="hidden" name="ETagValue" value="@Model.ETag" />
                                @foreach (var other in Model.Sections)
                                {
                                    <input type="hidden" name="SectionOrder" value="@other.Id.Value" />
                                }
                                <partial name="Ui/_Button" model="upButton" />
                            </form>
                            <form method="post" asp-page-handler="MoveDown">
                                <input type="hidden" name="SectionId" value="@entry.Id.Value" />
                                <input type="hidden" name="ETagValue" value="@Model.ETag" />
                                @foreach (var other in Model.Sections)
                                {
                                    <input type="hidden" name="SectionOrder" value="@other.Id.Value" />
                                }
                                <partial name="Ui/_Button" model="downButton" />
                            </form>
                            <partial name="Ui/_Button" model="deleteLink" />
                        </div>
                        </div>
                        </details>
                    }
                </li>
            }
        </ol>
    }
<div class="gliederung__neu" id="neuer-abschnitt">
    <h2>Ein neuer Abschnitt</h2>
    <p>Was möchtest du als Nächstes festhalten?</p>
    <form method="post" asp-page-handler="AddSection">
        <input type="hidden" name="ETagValue" value="@Model.ETag" />
        <partial name="Ui/_Field" model="newHeadingField" />
        <partial name="Ui/_Button" model="addButton" />
    </form>
</div>
</div>
</div>
</div>
