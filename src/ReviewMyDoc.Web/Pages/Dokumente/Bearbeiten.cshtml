@page "/dokumente/{documentId}"
@* The document is the workspace. Review controls sit beside it and appear at a selection. *@
@using ReviewMyDoc.Web.Pages.Dokumente
@model BearbeitenModel
@{
    ViewData["Title"] = Model.Document.Document.Title;
    var document = Model.Document.Document;
    var sections = Model.Sections.Count > 0 ? Model.Sections : new[] { new EditorSection("", "Dokumenttext", "", "", "") };
}
<link rel="stylesheet" href="~/components/document-editor/document-editor.css" asp-append-version="true" />
<div class="writing-workspace" data-document-editor data-document-etag="@Model.Document.ETag.Value"
     data-draft-id="@Model.Collection?.Review.Id" data-draft-etag="@Model.Collection?.ETag.Value">
    <header class="writing-workspace__header">
        <a href="/dokumente">← Dokumente</a>
        <span role="status" aria-live="polite" data-save-status>Alle Änderungen gespeichert</span>
        <nav aria-label="Dokumentaktionen">
            <button class="button button--secondary" type="button" data-save-all hidden>Speichern</button>
            <a href="/dokumente/@document.Id.Value/gliederung">Gliederung</a>
            <a href="/">Pipeline</a>
        </nav>
    </header>
    <div class="writing-workspace__layout">
        <article class="writing-workspace__paper">
            <p class="writing-workspace__eyebrow">Dein Dokument</p>
            <h1>@document.Title</h1>
            <div class="document-editor__tools" data-editor-tools hidden aria-label="Werkzeuge für die Markierung">
                <button type="button" data-format="bold" aria-label="Fett (Strg+B)"><strong>B</strong></button>
                <button type="button" data-format="italic" aria-label="Kursiv (Strg+I)"><em>I</em></button>
                <button type="button" data-format="h2">Überschrift</button>
                <button type="button" data-format="insertUnorderedList">Liste</button>
                <button type="button" data-collect>+ Sammeln</button>
                <button type="button" data-assign>Zum Review →</button>
            </div>
            @foreach (var entry in sections)
            {
                <form method="post" asp-page-handler="Save" class="document-editor" data-editor-section data-section-id="@entry.Id" data-text-etag="@entry.ETag">
                    <input type="hidden" name="sectionId" value="@entry.Id" />
                    <input type="hidden" name="etag" value="@entry.ETag" />
                    <input type="hidden" name="documentETag" value="@Model.Document.ETag.Value" />
                    @if (entry.Heading != "Dokumenttext") { <h2 class="document-editor__section-heading">@entry.Heading</h2> }
                    <div class="document-editor__surface" data-editor-surface hidden role="textbox" aria-multiline="true" aria-label="@entry.Heading bearbeiten" data-placeholder="Schreib einfach los. Markiere später eine Passage, um sie prüfen zu lassen.">@Html.Raw(entry.Html)</div>
                    <div data-editor-fallback>
                        <label for="text-@entry.Id">@entry.Heading bearbeiten</label>
                        <textarea id="text-@entry.Id" name="markdown" rows="16">@entry.Markdown</textarea>
                        <button class="button button--primary" type="submit">Text speichern</button>
                    </div>
                </form>
            }
        </article>
        <aside class="writing-workspace__review" aria-label="Review vorbereiten">
            <p class="writing-workspace__eyebrow">Zusammen weiterdenken</p>
            <h2>Für das Review</h2>
            <p>Markiere Text im Dokument. Weise ihn direkt zu oder sammle mehrere Passagen für einen gemeinsamen Auftrag.</p>
            <p class="writing-workspace__count"><span data-collection-count>@(Model.Collection?.Review.Passages.Count ?? 0)</span> <span data-collection-label>@(Model.Collection?.Review.Passages.Count == 1 ? "Passage gesammelt" : "Passagen gesammelt")</span></p>
            <ol data-collection-list class="writing-workspace__collection">
                @foreach (var passage in Model.Collection?.Review.Passages ?? [])
                { <li>@Model.Preview(passage.Markdown)</li> }
            </ol>
            <a class="button button--primary" data-collection-link href="@(Model.Collection is null ? null : $"/dokumente/{document.Id.Value}/reviews/{Model.Collection.Review.Id}")" hidden="@(Model.Collection is null)">Sammlung zuweisen →</a>
            <p><a href="/">Aufträge &amp; Rückmeldungen ansehen</a></p>
            <p class="writing-workspace__hint">Du entscheidest, was geteilt wird. Empfänger sehen nur die zugewiesenen Passagen.</p>
        </aside>
    </div>
</div>
@section Scripts {
    <script type="module" src="~/components/document-editor/document-editor.js" asp-append-version="true"></script>
}
