@page "/dokumente/{documentId}"
@* The document is the workspace. Review controls sit beside it and appear at a selection. *@
@using ReviewMyDoc.Web.Pages.Dokumente
@model BearbeitenModel
@using ReviewMyDoc.Core.Documents
@{
    ViewData["Title"] = Model.Document.Document.Title;
    var document = Model.Document.Document;
    var sections = Model.Sections.Count > 0 ? Model.Sections : new[] { new EditorSection("", "Dokumenttext", "", "", "") };
}
<link rel="stylesheet" href="~/components/document-editor/document-editor.css" asp-append-version="true" />
<div class="writing-workspace" data-document-editor="@(document.State == DocumentState.Approved ? null : "")" data-document-etag="@Model.Document.ETag.Value"
     data-draft-id="@Model.Collection?.Review.Id" data-draft-etag="@Model.Collection?.ETag.Value">
    <header class="writing-workspace__header">
        <a href="/dokumente">← Dokumente</a>
        <span role="status" aria-live="polite" data-save-status>@(Model.Message is null ? "Alle Änderungen gespeichert" : "Eingabe bitte prüfen")</span>
        <nav aria-label="Dokumentaktionen">
            <button class="button button--secondary" type="button" data-save-all hidden>Speichern</button>
            <button class="button button--secondary" type="button" data-open-reviews hidden>Review-Sets</button>
            <a href="/dokumente/@document.Id.Value/gliederung">Gliederung</a>
            <a href="/">Pipeline</a>
        </nav>
    </header>
    @if (Model.Message is not null) { <div class="review-workspace__notice" role="alert"><p>@Model.Message</p><a href="/dokumente/@document.Id.Value" target="_blank" rel="noopener">Aktuellen Stand in neuem Tab öffnen</a></div> }
    <div class="writing-workspace__layout">
        <article class="writing-workspace__paper">
            <p class="writing-workspace__eyebrow">Dein Dokument</p>
            <h1>@document.Title</h1>
            <div class="document-editor__tools" data-editor-tools hidden aria-label="Werkzeuge für die Markierung">
                <button type="button" data-format="bold" aria-label="Fett (Strg+B)"><strong>B</strong></button>
                <button type="button" data-format="italic" aria-label="Kursiv (Strg+I)"><em>I</em></button>
                <button type="button" data-format="h2">Überschrift</button>
                <button type="button" data-format="insertUnorderedList">Liste</button>
                <div class="document-editor__set-choices" data-review-choices role="group" aria-label="Review-Set für Markierung"></div>
                <select data-review-select aria-label="Weitere Review-Sets" hidden></select>
                <button type="button" data-collect>Zum Set hinzufügen</button>
            </div>
            @foreach (var entry in sections)
            {
                <form method="post" asp-page-handler="Save" class="document-editor" data-editor-section data-section-id="@entry.Id" data-text-etag="@entry.ETag">
                    <input type="hidden" name="sectionId" value="@entry.Id" />
                    <input type="hidden" name="etag" value="@entry.ETag" />
                    <input type="hidden" name="documentETag" value="@Model.Document.ETag.Value" />
                    @if (entry.Heading != "Dokumenttext") { <h2 class="document-editor__section-heading">@entry.Heading</h2> }
                    <div class="document-editor__surface" data-editor-surface aria-label="@entry.Heading" data-placeholder="Schreib einfach los. Markiere später eine Passage, um sie prüfen zu lassen.">@Html.Raw(entry.Html)</div>
                    @if (document.State != DocumentState.Approved)
                    {
                    <div data-editor-fallback>
                        <label for="text-@entry.Id">@entry.Heading bearbeiten</label>
                        <textarea id="text-@entry.Id" name="markdown" rows="16" maxlength="500000">@entry.Markdown</textarea>
                        <button class="button button--primary" type="submit">Text speichern</button>
                    </div>
                    }
                </form>
                @if (document.State != DocumentState.Approved && entry.Id.Length > 0)
                { <noscript><form method="post" asp-page-handler="CollectSection"><input type="hidden" name="sectionId" value="@entry.Id" /><input type="hidden" name="etag" value="@entry.ETag" />
                    <label for="set-@entry.Id">Review-Set für diesen Abschnitt</label><select id="set-@entry.Id" name="draftId" required>
                    @foreach (var set in Model.Collections.Where(r => r.Review.CollectionClosedAt is null)) { <option value="@set.Review.Id">@set.Review.SetName</option> }
                    </select><button class="button button--secondary" disabled="@(Model.Collection is null)">Diesen Abschnitt zum Review sammeln</button>
                    @if (Model.Collection is null) { <p>Lege zuerst ein Review-Set in der Seitenleiste an.</p> }
                </form></noscript> }
            }
        </article>
        <aside class="writing-workspace__review" aria-label="Review vorbereiten">
            <p class="writing-workspace__eyebrow">Zusammen weiterdenken</p>
            <partial name="_ReviewCollection" model="Model" />
            <p><a href="/">Aufträge &amp; Rückmeldungen ansehen</a></p>
            <details class="document-editor__secondary-details"><summary>Dokumentfreigabe</summary>
            <p>@(document.State == DocumentState.Approved ? "Freigegeben. Vor weiteren Änderungen bitte wieder öffnen." : "Nach Abnahme aller Aufträge kannst du das Dokument ausdrücklich freigeben.")</p>
            <form method="post" asp-page-handler="Approval"><input type="hidden" name="etag" value="@Model.Document.ETag.Value" /><input type="hidden" name="approve" value="@(document.State != DocumentState.Approved ? "true" : "false")" /><button class="button button--secondary">@(document.State == DocumentState.Approved ? "Zur Bearbeitung öffnen" : "Dokument freigeben")</button></form>
            </details>
        </aside>
    </div>
</div>
@section Scripts {
    <script type="module" src="~/components/document-editor/document-editor.js" asp-append-version="true"></script>
}
