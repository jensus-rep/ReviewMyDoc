@page "/dokumente"
@*
    The list of every document: built by listing the object store by prefix, see
    IndexModel and docs/Datenmodell.md, not by a second file that names them and
    could fall out of step. Newest change first. An empty list gets a designed
    empty state that says what to do next instead of a blank page, and the way
    to the next document, /dokumente/anlegen, is the one link this page adds to
    the frame's own navigation.
*@
@using ReviewMyDoc.Web.Pages.Shared.Ui
@model IndexModel
@{
    ViewData["Title"] = "Dokumente";

    var neu = new ButtonModel("Neues Dokument") { Href = "/dokumente/anlegen" };
}

<div class="document-library">
<header class="document-view__header">
    <div>
        <p class="document-view__eyebrow">Dein Arbeitsbereich</p>
        <h1>Dokumente</h1>
        <p>Gedanken sammeln. Inhalte entwickeln. Gemeinsam weiterdenken.</p>
    </div>
    @if (Model.Rows.Items.Count > 0)
    {
        <partial name="Ui/_Button" model="neu" />
    }
</header>

@if (Model.Rows.Items.Count == 0)
{
    <div class="document-view__paper document-view__empty">
        <span class="document-view__empty-mark" aria-hidden="true">¶</span>
        <h2>Dein nächstes Dokument beginnt hier</h2>
        <p>Es gibt noch keine Dokumente.</p>
        <p>Leg dein erstes Dokument an, um mit dem Schreiben zu beginnen.</p>
        <partial name="Ui/_Button" model="neu" />
    </div>
}
else
{
    <p class="document-library__count">@Model.Rows.Items.Count @(Model.Rows.Items.Count == 1 ? "Dokument" : "Dokumente") · Zuletzt geändert zuerst</p>
    <partial name="Ui/_Rows" model="Model.Rows" />
}
</div>
