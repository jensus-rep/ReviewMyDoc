<!--
  The web application: Razor Pages, composition of services and middleware, and
  delivery of the framework free building blocks under /components/.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ReviewMyDoc.Core\ReviewMyDoc.Core.csproj" />
    <ProjectReference Include="..\ReviewMyDoc.Infrastructure\ReviewMyDoc.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    The building blocks stay where they are and are copied into the published
    output next to the application, so /components/ finds them there as well.
    Not into wwwroot and not into the build output: locally the application
    reads them straight out of the repository, which is what makes a change to a
    building block visible without a build.
  -->
  <ItemGroup>
    <Content Include="..\..\components\**\*"
             Link="components\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Never"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
