<!--
  Unit tests for ReviewMyDoc.Core and integration tests for the web application
  through WebApplicationFactory. Every check of the pipeline runs from here.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReviewMyDoc.Core\ReviewMyDoc.Core.csproj" />
    <ProjectReference Include="..\..\src\ReviewMyDoc.Infrastructure\ReviewMyDoc.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ReviewMyDoc.Web\ReviewMyDoc.Web.csproj" />
  </ItemGroup>

</Project>
