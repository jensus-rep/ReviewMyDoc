<!--
  Unit tests for ReviewMyDoc.Core and integration tests for the web application
  through WebApplicationFactory. Every check of the pipeline runs from here.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!--
      WebApplicationFactory and the TestServer behind it: the integration tests
      of docs/Konventionen.md, section Tests, start the application in the
      process of the test and never a port of their own.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!--
      xunit.v3 und nicht xunit 2.x: docs/Konventionen.md, Abschnitt Tests,
      verlangt Tests, die ohne konfigurierte Verbindung mit genanntem Grund
      übersprungen werden. Das setzt voraus, dass eine Testmethode zur Laufzeit
      überspringen kann (Assert.Skip). xunit 2.x kann das nicht, und die
      Vertragsklasse, in der die Testmethoden stehen, darf dafür nicht
      geändert werden. Der bisherige Testlauf bleibt unverändert: dieselben
      Befehle, derselbe VSTest-Runner.
    -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReviewMyDoc.Core\ReviewMyDoc.Core.csproj" />
    <ProjectReference Include="..\..\src\ReviewMyDoc.Infrastructure\ReviewMyDoc.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ReviewMyDoc.Web\ReviewMyDoc.Web.csproj" />
  </ItemGroup>

</Project>
